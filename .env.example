# Variáveis do app. O único backend é o Appwrite.
#
# VITE_*  -> vão para o navegador. São identificadores públicos, não segredos.
# O resto -> só no servidor (Vercel > Settings > Environment Variables).
#            Nunca com prefixo VITE_ e nunca dentro do git.

# --- Navegador ---
VITE_APPWRITE_ENDPOINT=https://appwrite.agenc-ia.net/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_BUCKET_ID=trip-attachments
# Endereço público do app (links de convite). Opcional.
VITE_APP_URL=

# --- Servidor: Appwrite ---
# Obrigatória. Sem ela o servidor não lê nem grava: IA, convites, e-mail,
# a entrada de leads do n8n e o formulário de captação param de funcionar.
# Escopos: databases.read, databases.write, documents.read, documents.write, files.read
APPWRITE_API_KEY=
# Opcionais: usam os VITE_APPWRITE_* quando ausentes.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=

# --- Servidor: app ---
APP_URL=
# Super admins, separados por vírgula.
SUPER_ADMIN_EMAILS=

# --- Servidor: IA (uma das duas chaves) ---
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_MODEL=
AI_DEFAULT_MONTHLY_TOKENS=

# --- Servidor: entrada de leads pelo n8n ---
N8N_LEAD_WEBHOOK_SECRET=
N8N_DEFAULT_AGENCY_ID=

# --- Servidor: Google ---
# JSON da conta de serviço do Firebase (notificações push).
FIREBASE_SERVICE_ACCOUNT=
# JSON da conta de serviço que lê o Google Drive. Compartilhe a pasta do Drive
# com o e-mail dessa conta, como leitor.
GOOGLE_DRIVE_SERVICE_ACCOUNT=

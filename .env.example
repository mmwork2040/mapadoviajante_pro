# Copie para .env (local) ou configure na Vercel. Só o Appwrite é backend deste app.

# --- Navegador (públicas; vão para o código do site) ---
VITE_APPWRITE_ENDPOINT="https://appwrite.agenc-ia.net/v1"
VITE_APPWRITE_PROJECT_ID="6abdb8190017d98565f5"
VITE_APPWRITE_DATABASE_ID="6abdb82f002c563b2ad3"
VITE_APPWRITE_BUCKET_ID="trip-attachments"
# Endereço público do app (prévia de links compartilhados).
VITE_APP_URL="https://mapadoviajante-pro.vercel.app"

# --- Servidor (segredos; configurar só na Vercel, nunca em VITE_*) ---
# Chave de API do Appwrite usada pelas funções de servidor e pelas rotas públicas.
# Escopos: databases.read, databases.write, documents.read, documents.write, files.read.
APPWRITE_API_KEY=
# Opcionais: usam os VITE_APPWRITE_* acima quando vazios.
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
# Endereço público usado nos links de convite.
APP_URL="https://mapadoviajante-pro.vercel.app"
# Super admins da plataforma, separados por vírgula.
SUPER_ADMIN_EMAILS=

# IA (chave só no servidor) e cota padrão de tokens por agência.
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_MODEL=
AI_DEFAULT_MONTHLY_TOKENS=

# Google: JSON da conta de serviço, em uma linha.
# Push (Firebase Cloud Messaging).
FIREBASE_SERVICE_ACCOUNT=
# Google Drive (leitura). Compartilhe a pasta da agência com o e-mail da conta de serviço.
GOOGLE_DRIVE_SERVICE_ACCOUNT=

# Entrada de viagens pelo n8n (/api/public/n8n-lead).
N8N_LEAD_WEBHOOK_SECRET=
N8N_DEFAULT_AGENCY_ID=
